# SalesPilot AI - Backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Application
APP_NAME=SalesPilot AI
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Placeholders for later modules (do NOT fill these in Module 1):
# AI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/salespilot
# ---------------------------------------------------------------------------
