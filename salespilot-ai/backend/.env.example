# SalesPilot AI - Backend environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
#
# Development vs production: keep separate .env files (e.g. .env.development,
# .env.production) and set APP_ENV accordingly. Never hardcode secrets.

# Application
APP_NAME=SalesPilot AI
APP_ENV=development            # development | staging | production
API_VERSION=v1
APP_VERSION=0.1.0
DEBUG=true                     # MUST be false in production (validated at startup)

# Server
HOST=0.0.0.0
PORT=8000

# CORS - comma-separated list of allowed frontend origins.
# Do NOT use wildcard origins together with credentials in production.
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR

# ---------------------------------------------------------------------------
# Placeholders for later modules (do NOT fill these in Module 2):
# AI_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/salespilot
# ---------------------------------------------------------------------------
